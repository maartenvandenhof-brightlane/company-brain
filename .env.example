# =============================================================================
# Company Brain — optional configuration. Everything has a default: a clean
# `docker compose up -d` (or `make up`) works without a .env. The mode and its
# settings are chosen in the setup wizard (http://localhost:8080/setup) and saved
# in data/config.yaml; the BRAIN_* variables below only prefill the wizard.
# Secrets are never set here: the brain generates its tokens in data/secrets/ and
# the wizard stores the admin password hash there. Never commit .env.
# =============================================================================

# --- Host -------------------------------------------------------------------
# Your user and group id: the brain and portal run as this user so the files in
# the data folder stay editable by you. `make up` fills these in for you.
HOST_UID=1000
HOST_GID=1000
# Host ports, published on 127.0.0.1 only. The brain port serves the setup wizard,
# settings page and REST API; the portal port the wiki explorer and proposal review.
BRAIN_PORT=8080
PORTAL_PORT=3090
# Where the data lives on the host: config.yaml, secrets/, state/, portal/ and wiki/.
BRAIN_DATA_DIR=./data
# The wiki itself (a git repo of markdown files, editable in Obsidian or VS Code).
# Point it at another folder to keep the wiki elsewhere.
BRAIN_WIKI_DIR=./data/wiki
# Shown in the wizard, the portal and the connector's login page.
WIKI_TITLE=Company Brain
# Image tags of the locally built images.
BRAIN_VERSION=0.1.0
PORTAL_VERSION=0.1.0

# --- Wizard prefill (the wizard still asks you to confirm) -------------------
# mcp | gdrive | both
BRAIN_MODE=
# Google Drive folder the pages are exported to (gdrive/both).
BRAIN_DRIVE_FOLDER=Company Brain
# Inbox for notes saved from the chat app: tasks (Google Tasks, any account) or
# keep (Google Keep, needs a Workspace admin's domain-wide delegation).
INBOX_ADAPTER=tasks
# Title prefix of the notes the inbox picks up.
BRAIN_NOTE_PREFIX=[brain]
# Keep inbox only: delete a note once it is saved to the brain (true needs the
# read-write keep scope in the domain-wide delegation; false keeps notes in Keep).
KEEP_DELETE_AFTER_INGEST=false
# The Google OAuth client, the refresh token and the Keep service account key are
# entered in the wizard and stored in data/secrets/, never here.

# --- MCP connector (mcp/both) -------------------------------------------------
# The public HTTPS URL comes from the tailscale sidecar: the Tailscale auth key and
# machine name are entered in the wizard and stored in data/tailscale/, never here.
# Clients whose metadata documents the OAuth server accepts (claude.ai, ...).
CIMD_ALLOWED_HOSTS=claude.ai,claude.com,chatgpt.com,openai.com
# The owner's user name on the connector and portal login (the password is the
# wizard's admin password).
OWNER_USERNAME=owner

# --- Trust and access ---------------------------------------------------------
# Writes whose trust is at or below this level become proposals for review:
# none | external | agent | owner
PROPOSALS_FOR=external
# Scopes of the REST API bearer token (data/secrets/internal_token, trust agent).
# Add wiki:admin to accept proposals, wiki:private to see private pages.
INTERNAL_SCOPES=wiki:read,wiki:write

# --- Git and maintenance ------------------------------------------------------
# Optional remote to push the wiki to (debounced after each change), and its branch.
GIT_REMOTE_URL=
GIT_REMOTE_BRANCH=main
# Nightly lint report time (HH:MM, UTC); empty disables it.
LINT_SCHEDULE=03:30
# Portal sign-in: idle and absolute session lifetime in seconds.
PORTAL_SESSION_IDLE_S=1800
PORTAL_SESSION_MAX_S=43200
# DEBUG | INFO | WARNING
LOG_LEVEL=INFO
